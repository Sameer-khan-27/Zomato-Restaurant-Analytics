# Raw data - never commit large CSVs
data/raw/*
!data/raw/.gitkeep

# Processed outputs - track only compressed/csv
data/processed/*.parquet
!data/processed/*.csv.gz
!data/processed/*.csv

# Python
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/
env/

# Misc
.DS_Store
*.egg-info/
dist/
